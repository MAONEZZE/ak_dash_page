# URL base do BFF (ak_dash). Deixe vazio em dev se usar VITE_USE_FIXTURES=true.
VITE_API_BASE_URL=http://localhost:8000

# true = serve os JSONs de docs/contract/fixtures/ em vez de chamar o BFF.
# Útil para desenvolver o frontend antes do BFF estar de pé.
VITE_USE_FIXTURES=false

# Credenciais do projeto Supabase (Settings > API no painel) — obrigatórias
# para o login funcionar. Sem elas, a tela de login aparece mas toda
# tentativa de entrar falha (cliente Supabase usa um placeholder inerte).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
